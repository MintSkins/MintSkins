<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>MintSkins</vendor>
  <vendor_url>https://github.com/PablUoo/MintSkins</vendor_url>
  <icon_name>mintskins</icon_name>
  <action id="io.github.pabluoo.mintskins.tela-de-login">
    <description>Change the login screen appearance</description>
    <description xml:lang="pt_BR">Alterar o visual da tela de login</description>
    <message>Authentication is required to change the login screen</message>
    <message xml:lang="pt_BR">O MintSkins precisa da sua senha para alterar a tela de login</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mintskins/mintskins-login-helper</annotate>
  </action>
</policyconfig>
